{
  "manifest_version": 3,
  "name": "strwBooster",
  "version": "2.0.0",
  "description": "Boost a tab's audio past 100%, with a limiter and per-site memory.",
  "permissions": ["scripting", "storage", "tabs"],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_popup": "popup.html",
    "default_title": "strwBooster",
    "default_icon": {
      "512": "icons/icon512.png"
    }
  },
  "icons": {
    "512": "icons/icon512.png"
  },
  "background": {
    "service_worker": "background.js"
  }
}
